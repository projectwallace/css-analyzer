{
	"compilerOptions": {
		// Base options:
		"skipLibCheck": true,
		// TODO: set to es2025 on next major version
		"target": "es2022",
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",

		// Strictness
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitAny": true,

		// Node-compatible module resolution: relative imports must include a file
		// extension, and we use `.ts` so source runs as-is with Node's type stripping
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true,

		// Type checking, not transpiling
		"allowSyntheticDefaultImports": true,
		"noEmit": true,
		"declaration": true,
		"isolatedDeclarations": true,

		// Code runs in the DOM
		"lib": ["ES2022", "ES2025.Collection", "DOM", "DOM.Iterable"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules"]
}
