{
	"extends": ["./node_modules/@projectwallace/preset-oxlint/index.json"],
	"rules": {
		"no-null": "allow",
		"no-warning-comments": "allow",
		"max-depth": ["warn", 6],
		"prefer-const": "error",
		"no-var": "error",
		"no-unused-vars": "error",
		"func-style": ["error", "declaration", { "allowArrowFunctions": false }],
		// Relative imports must use `.ts` so the source runs as-is in Node (type stripping)
		"import/extensions": [
			"error",
			"always",
			{
				"ignorePackages": true,
				"pattern": {
					"js": "never",
					"mjs": "never",
					"cjs": "never"
				}
			}
		]
	}
}
