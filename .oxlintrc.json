{
	"extends": ["./node_modules/@projectwallace/preset-oxlint/index.json"],
	"rules": {
		"no-null": "allow",
		"no-warning-comments": "allow",
		"max-depth": ["warn", 6],
		"prefer-const": "error",
		"no-var": "error",
		"no-unused-vars": "error",
		"func-style": ["error", "declaration", { "allowArrowFunctions": false }]
	}
}
